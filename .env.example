# --- LLM provider ---------------------------------------------------------
# "api"    = ANY OpenAI-compatible site (Groq, OpenRouter, Together, Cerebras, ...)
# "ollama" = local models.
# If unset: "api" when LLM_API_KEY is present, else Ollama.
LLM_PROVIDER=api

# To switch sites/models, change ONLY these three lines:
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
# Optional: different model for AI Search / vision (default = LLM_MODEL).
# LLM_SEARCH_MODEL=
# LLM_VISION_MODEL=
# Optional: "none" turns off thinking on Groq Qwen3. Leave empty on other sites.
LLM_REASONING_EFFORT=
#
# Base URL cheat-sheet:
#   Groq        https://api.groq.com/openai/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Together    https://api.together.xyz/v1
#   Cerebras    https://api.cerebras.ai/v1
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai
#   Mistral     https://api.mistral.ai/v1

# Retries on transient failures (429/5xx, connection error, empty or non-JSON
# answer). Exponential backoff. 400/401/402/403 are NOT retried.
LLM_API_MAX_RETRIES=3
LLM_API_RETRY_BACKOFF_SECONDS=2
LLM_API_TIMEOUT_RETRIES=1
LLM_API_RETRY_BUDGET_SECONDS=300
# If the API fails (bad key, no credits, rate limit, timeout, 5xx) the request
# is repeated on local Ollama, and the API is skipped for a while.
LLM_FALLBACK_TO_OLLAMA=true
LLM_API_TIMEOUT_SECONDS=120
LLM_API_COOLDOWN_SECONDS=600
LLM_API_SHORT_COOLDOWN_SECONDS=60
LLM_MAX_TOKENS=4096
# Free tiers are rate limited, so keep calls per invoice low:
# LLM_MAX_RETRIES=1
# VISION_VERIFICATION_ENABLED=false

# --- OCR Engine ---
# Printed invoices -> PaddleOCR. Handwritten invoices -> TrOCR (auto-detected).
# See ocr/ocr_engine.py and ocr/handwriting_detector.py.
OCR_LANG=en
TROCR_MODEL_NAME=microsoft/trocr-base-handwritten

# --- Handwriting Detection ---
# Stroke-width-variance heuristic. Higher threshold = harder to classify as
# handwritten = more documents stay on PaddleOCR. Tune against real samples.
HANDWRITING_SWT_THRESHOLD=0.55
HANDWRITING_MIN_COMPONENTS=15
# On by default — deskew + denoise + CLAHE contrast enhancement, run before
# OCR. This is what helps real phone-photo receipts (faded thermal paper,
# glare, uneven lighting). Turn off only if you've confirmed it hurts
# accuracy for your document source.
OCR_PREPROCESS_ENABLED=true
# Off by default — hard binarization tends to hurt PaddleOCR/TrOCR (deep
# models trained on natural photos) more than it helps, especially on real
# phone photos with glare/shadows/uneven lighting. Only turn on if you've
# tested it actually improves accuracy for your specific document source.
OCR_PREPROCESS_BINARIZE=false

# --- AI / LLM (Ollama, local) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b        # or llama3:8b
LLM_TEMPERATURE=0.1
LLM_MAX_RETRIES=3
LLM_STOP_ON_STALLED_VALIDATION=true
# Generous default: a local CPU-run 7B model on a multi-page PDF's full OCR
# text can genuinely take longer than 120s to generate a full JSON response.
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_TIMEOUT_RETRIES=1
OLLAMA_KEEP_ALIVE=30m
# Hybrid Search uses the local parser before any LLM call.
# For complex requests, use the selected API mode (LLM_SEARCH_MODEL) or this Ollama text model.
# SEARCH_LLM_MODEL does not change invoice extraction settings.
SEARCH_LLM_MODEL=qwen2.5:7b
SEARCH_LLM_TIMEOUT_SECONDS=90

# --- Vision cross-check (optional, see ai/vision_verifier.py) ---
# Independent second read of the invoice IMAGE (not the OCR text) for the
# fields where a misread is costliest — catches OCR errors the text-only
# LLM step can't see, since it never has access to the image itself.
# Requires the model to actually be pulled in Ollama first:
#   ollama pull qwen2.5vl:7b
# When enabled, conditional verification may run on difficult invoices; not all invoices.
VISION_VERIFICATION_ENABLED=true
VISION_MODEL=qwen2.5vl:7b
VISION_TIMEOUT_SECONDS=180
VISION_NUM_CTX=8192

# Generic high-resolution second pass for tiny vendor header text (for example
# white-on-dark VAT TIN/address text that whole-page OCR may miss).
VENDOR_HEADER_RECOVERY_ENABLED=true
VENDOR_HEADER_CROP_RATIO=0.28
VENDOR_HEADER_UPSCALE=3.0

# Dedicated high-resolution vision crop for handwritten/garbled invoice dates
HANDWRITTEN_DATE_VERIFY_ENABLED=true

# --- Database ---
DATABASE_URL=sqlite:///./data/invoices.db

# --- Storage ---
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed
TEMP_DIR=./data/temp
EXPORT_DIR=./storage/exports

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
MAX_UPLOAD_MB=15
CONFIDENCE_THRESHOLD=0.75
# Fallback only used when the LLM can't determine currency from the
# document at all (e.g. a receipt with no visible currency symbol/code).
# Set to match where your invoices come from, e.g. PHP for Philippine receipts.
DEFAULT_CURRENCY=PHP

# 1.55 targeted layout verification
STATEMENT_SUMMARY_VERIFY_ENABLED=true
CUSTOMER_ADDRESS_VERIFY_ENABLED=true

# 1.60 focused final-field verification
VENDOR_ADDRESS_VERIFY_ENABLED=true
PLATE_NUMBER_VERIFY_ENABLED=true

# Optional direct scanner integration (Windows). Install free NAPS2 separately.
# Usually auto-detected at C:\Program Files\NAPS2\NAPS2.Console.exe
# Set this only for a custom/portable install; keep it on one line.
# NAPS2_CONSOLE_PATH="C:/Program Files/NAPS2/NAPS2.Console.exe"

# CPU reliability/speed: no model change and no shorter timeouts.
VISION_BATCH_GUARD_ENABLED=true
LLM_EARLY_CLEANUP_ENABLED=true

# Per-file model time only; OCR/image preparation does not consume these.
# API/local and text/vision have separate allowances. Existing legacy
# PROCESSING_BUDGET_SECONDS=30 is ignored by the v6 model budget implementation.
API_TEXT_BUDGET_SECONDS=150
LOCAL_TEXT_BUDGET_SECONDS=600
API_VISION_BUDGET_SECONDS=180
LOCAL_VISION_BUDGET_SECONDS=360
LLM_CONTEXT_TOKENS=16384
